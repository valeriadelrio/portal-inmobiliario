# Postgres local (docker compose up -d)
DATABASE_URL=postgres://portal:portal@localhost:5433/portal

# Supabase (Settings > API). La clave publishable es pública; DATABASE_URL NO.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dónde se sirven las fotos públicas (CDN/dominio de R2). Vacío en desarrollo: se sirven desde /media.
NEXT_PUBLIC_MEDIA_BASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# local (desarrollo: guarda en .local-media/) | memory (tests) | r2 (producción, pendiente)
STORAGE_DRIVER=local
# Solo cuando STORAGE_DRIVER=r2 (pieza 2C)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Emails reales (H4). Sin esto se imprimen en consola.
RESEND_API_KEY=
EMAIL_FROM=
